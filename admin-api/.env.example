# Never commit a real service-account key. In Render, add these in Environment.
FIREBASE_PROJECT_ID=tasklink-fb027
# Single-line JSON copied from a Firebase Admin service-account key:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Comma-separated browser origins allowed to call this API.
ADMIN_PORTAL_ORIGINS=https://YOUR-ADMIN-PORTAL.onrender.com
