{
  "expo": {
    "name": "TASKLINK",
    "slug": "tasklink",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tasklink",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "android": {
      "package": "com.tasklink.app",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#005C55",
          "defaultChannel": "tasklink-updates"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ae0d465-4d23-45b5-91dd-a29fef56cdcd"
      }
    },
    "owner": "harvz1827"
  }
}
