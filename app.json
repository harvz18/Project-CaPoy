{
  "expo": {
    "name": "TASKLINK",
    "slug": "tasklink",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tasklink",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "android": {
      "package": "com.tasklink.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#005C55",
          "defaultChannel": "tasklink-updates"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TaskLink to choose photos and documents for your account.",
          "cameraPermission": "Allow TaskLink to use your camera for identity verification and profile photos."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a7d5f05-f8f2-45cb-a820-31bdff543ef0"
      }
    },
    "owner": "shaolin18"
  }
}
