rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasEnabledAccount() {
      return signedIn()
        && !(currentUser().get('accountStatus', 'active') in [
          'suspended', 'Suspended', 'restricted', 'Restricted', 'deleted', 'Deleted'
        ]);
    }

    function hasRole(role) {
      return hasEnabledAccount() && currentUser().role == role;
    }

    function isAdmin() {
      return hasEnabledAccount()
        && (
          (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
          || (request.auth.token.keys().hasAny(['superadmin']) && request.auth.token.superadmin == true)
        );
    }

    function isSuperadmin() {
      return hasEnabledAccount()
        && request.auth.token.keys().hasAny(['superadmin'])
        && request.auth.token.superadmin == true;
    }

    function task(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data;
    }

    function taskAfter(taskId) {
      return getAfter(/databases/$(database)/documents/tasks/$(taskId)).data;
    }

    function matchAfter(matchId) {
      return getAfter(/databases/$(database)/documents/taskMatches/$(matchId)).data;
    }

    function verificationAfter(userId) {
      return getAfter(/databases/$(database)/documents/verificationRequests/$(userId)).data;
    }

    function isTaskClient(taskData) {
      return hasEnabledAccount() && taskData.get('clientId', '') == request.auth.uid;
    }

    function isTaskWorker(taskData) {
      return hasEnabledAccount() && taskData.get('workerId', '') == request.auth.uid;
    }

    function isTaskApplicant(taskData) {
      return hasEnabledAccount()
        && taskData.get('applicantIds', []) is list
        && request.auth.uid in taskData.get('applicantIds', []);
    }

    function isTaskParticipant(taskData) {
      return isTaskClient(taskData) || isTaskWorker(taskData) || isTaskApplicant(taskData);
    }

    function isNotificationParticipant(taskData, userId) {
      return taskData.clientId == userId
        || ('workerId' in taskData && taskData.workerId == userId)
        || (taskData.applicantIds is list && userId in taskData.applicantIds);
    }

    function isConversationWorker(taskData, workerId) {
      return ('workerId' in taskData && taskData.workerId == workerId)
        || (taskData.applicantIds is list && workerId in taskData.applicantIds);
    }

    function validConversationParticipants(taskData, workerId, participantIds) {
      return participantIds is list
        && participantIds.size() == 2
        && participantIds.hasAll([taskData.clientId, workerId])
        && participantIds.hasOnly([taskData.clientId, workerId]);
    }

    function isOpenTask(taskData) {
      return taskData.get('status', '') in ['Finding Workers', 'Applied'];
    }

    function applicationApplicantIds(taskData) {
      return taskData.get('applicantIds', []) is list ? taskData.get('applicantIds', []) : [];
    }

    function hasNoAssignedWorker(taskData) {
      return taskData.get('workerId', null) == null || taskData.get('workerId', '') == '';
    }

    function isAssignedPaymentParticipant(taskData) {
      return hasEnabledAccount()
        && (taskData.clientId == request.auth.uid
          || taskData.get('workerId', '') == request.auth.uid);
    }

    function paymentProofFile(taskId, party) {
      return get(/databases/$(database)/documents/paymentProofFiles/$(taskId)/uploads/$(party)).data;
    }

    function paymentProofFileAfter(taskId, party) {
      return getAfter(/databases/$(database)/documents/paymentProofFiles/$(taskId)/uploads/$(party)).data;
    }

    function verificationFile(userId, kind) {
      return get(/databases/$(database)/documents/verificationFiles/$(userId)/uploads/$(kind)).data;
    }

    function verificationFileAfter(userId, kind) {
      return getAfter(/databases/$(database)/documents/verificationFiles/$(userId)/uploads/$(kind)).data;
    }

    function validVerificationDocumentPath(userId, path, kind) {
      return path is string
        && (path.matches('verification/' + userId + '/.*')
          || (path == 'firestoreVerification/' + userId + '/' + kind
            && verificationFile(userId, kind).status == 'ready'
            && verificationFile(userId, kind).uploaderId == request.auth.uid));
    }

    function validClientPaymentProofPath(taskId, proofPath) {
      return proofPath is string
        && (proofPath.matches('paymentProofs/' + taskId + '/.+')
          || (proofPath == 'firestorePaymentProofs/' + taskId + '/client'
            && paymentProofFile(taskId, 'client').status == 'ready'
            && paymentProofFile(taskId, 'client').uploaderId == request.auth.uid));
    }

    function validWorkerPaymentProofPath(taskId, proofPath) {
      return proofPath is string
        && (proofPath.matches('paymentProofs/' + taskId + '/.+')
          || (proofPath == 'firestorePaymentProofs/' + taskId + '/worker'
            && paymentProofFile(taskId, 'worker').status == 'ready'
            && paymentProofFile(taskId, 'worker').uploaderId == request.auth.uid));
    }

    function validGcashQrPath(taskId, proofPath) {
      return proofPath is string
        && proofPath == 'firestorePaymentProofs/' + taskId + '/worker-gcash-qr'
        && paymentProofFile(taskId, 'worker-gcash-qr').status == 'ready'
        && paymentProofFile(taskId, 'worker-gcash-qr').uploaderId == request.auth.uid;
    }

    function validGcashRecipientMobile(value) {
      return value is string && value.matches('09[0-9]{9}');
    }

    function validOwnUserDocument(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.role in ['worker', 'client'];
    }

    function validIdentityText(profileData) {
      return profileData.fullName is string
        && profileData.fullName.size() >= 2
        && profileData.fullName.size() <= 100
        && profileData.fullName.matches('.*[^ ].*')
        && profileData.address is string
        && profileData.address.size() >= 3
        && profileData.address.size() <= 200
        && profileData.address.matches('.*[^ ].*');
    }

    function identityLocked(profileData) {
      return profileData.get('identityStatus', null) == 'Approved'
        || profileData.get('verificationStatus', null) == 'Verified'
        || 'identityLockedAt' in profileData;
    }

    function validInitialIdentityState(profileData) {
      return (
          !('identityStatus' in profileData)
          || (profileData.role == 'worker' && profileData.identityStatus == 'Pending Approval')
          || (profileData.role == 'client' && profileData.identityStatus == 'Unverified')
        )
        && !('identityApprovedAt' in profileData)
        && !('identityApprovedBy' in profileData)
        && !('identityLockedAt' in profileData);
    }

    function validPrivateLocation(profileData) {
      return profileData.currentLatitude is number
        && profileData.currentLatitude >= -90
        && profileData.currentLatitude <= 90
        && profileData.currentLongitude is number
        && profileData.currentLongitude >= -180
        && profileData.currentLongitude <= 180
        && profileData.locationUpdatedAt is string
        && profileData.locationSource in ['device', 'manual']
        && (!('locationAccuracyMeters' in profileData)
          || (profileData.locationAccuracyMeters is number && profileData.locationAccuracyMeters >= 0));
    }

    function validOwnPrivateLocationUpdate(userId) {
      return hasEnabledAccount()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentLatitude',
          'currentLongitude',
          'locationUpdatedAt',
          'locationAccuracyMeters',
          'locationSource',
          'updatedAt'
        ])
        && validPrivateLocation(request.resource.data);
    }

    function validPreferredDiscoveryRadius(profileData) {
      return !('preferredRadiusKm' in profileData)
        || (profileData.preferredRadiusKm is number
          && profileData.preferredRadiusKm >= 1
          && profileData.preferredRadiusKm <= 50);
    }

    function validUserProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role',
          'fullName',
          'address',
          'skills',
          'capabilities',
          'businessName',
          'profilePhotoUrl',
          'experienceDescription',
          'yearsOfExperience',
          'validIdType',
          'validIdUrl',
          'medicalCertificateUrl',
          'policeClearanceUrl',
          'verificationStatus',
          'identityStatus',
          'availabilityStatus',
          'availability',
          'currentLatitude',
          'currentLongitude',
          'locationUpdatedAt',
          'locationAccuracyMeters',
          'locationSource',
          'preferredRadiusKm',
          'updatedAt'
        ])
        && validIdentityText(request.resource.data)
        && validPreferredDiscoveryRadius(request.resource.data)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fullName'])
          || (
            !identityLocked(resource.data)
            && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.fullName
              == request.resource.data.fullName
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'currentLatitude', 'currentLongitude', 'locationUpdatedAt', 'locationAccuracyMeters', 'locationSource'
          ])
          || validPrivateLocation(request.resource.data)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus'])
          || (
            !identityLocked(resource.data)
            && request.resource.data.verificationStatus == 'Pending Verification'
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['identityStatus'])
          || (
            !identityLocked(resource.data)
            && request.resource.data.role in ['worker', 'client']
            && request.resource.data.identityStatus == 'Pending Approval'
            && verificationAfter(request.auth.uid).status == 'Pending Verification'
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'validIdType', 'validIdUrl', 'medicalCertificateUrl', 'policeClearanceUrl'
          ])
          || (
            !identityLocked(resource.data)
            && request.resource.data.role in ['worker', 'client']
            && request.resource.data.verificationStatus == 'Pending Verification'
            && validVerificationDocumentPath(request.auth.uid, request.resource.data.validIdUrl, 'valid-id')
            && validVerificationDocumentPath(request.auth.uid, request.resource.data.medicalCertificateUrl, 'medical-certificate')
            && (!('policeClearanceUrl' in request.resource.data)
              || validVerificationDocumentPath(request.auth.uid, request.resource.data.policeClearanceUrl, 'police-clearance'))
            && verificationAfter(request.auth.uid).status == 'Pending Verification'
            && verificationAfter(request.auth.uid).validIdType == request.resource.data.validIdType
            && verificationAfter(request.auth.uid).validIdPath == request.resource.data.validIdUrl
            && verificationAfter(request.auth.uid).medicalCertificatePath == request.resource.data.medicalCertificateUrl
            && (!('policeClearanceUrl' in request.resource.data)
              || verificationAfter(request.auth.uid).policeClearancePath == request.resource.data.policeClearanceUrl)
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'availabilityStatus',
            'availability'
          ])
          || (
            resource.data.role == 'client'
            && request.resource.data.role == 'worker'
            && request.resource.data.availabilityStatus == 'Available'
            && request.resource.data.availability == 'Available'
          )
        );
    }

    function validWorkflowPrivateWorkerUpdate(userId) {
      return (hasRole('client') || (hasRole('worker') && request.auth.uid == userId))
        && resource.data.role == 'worker'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availabilityStatus',
          'availability',
          'activeTaskId',
          'completedTasks',
          'updatedAt'
        ])
        && (
          (
            resource.data.get('activeTaskId', null) == null
            && hasRole('client')
            && request.resource.data.activeTaskId is string
            && request.resource.data.availabilityStatus == 'Busy'
            && request.resource.data.availability == 'Busy'
            && request.resource.data.get('completedTasks', 0) == resource.data.get('completedTasks', 0)
            && task(request.resource.data.activeTaskId).status == 'Applied'
            && taskAfter(request.resource.data.activeTaskId).status == 'Accepted'
            && taskAfter(request.resource.data.activeTaskId).clientId == request.auth.uid
            && taskAfter(request.resource.data.activeTaskId).workerId == userId
          )
          ||
          (
            resource.data.activeTaskId is string
            && hasRole('client')
            && !('activeTaskId' in request.resource.data)
            && request.resource.data.availabilityStatus == 'Available'
            && request.resource.data.availability == 'Available'
            && request.resource.data.completedTasks == resource.data.get('completedTasks', 0) + 1
            && task(resource.data.activeTaskId).status == 'Pending Approval'
            && taskAfter(resource.data.activeTaskId).status == 'Finished'
            && taskAfter(resource.data.activeTaskId).clientId == request.auth.uid
            && taskAfter(resource.data.activeTaskId).workerId == userId
          )
          ||
          (
            resource.data.activeTaskId is string
            && hasRole('worker')
            && request.auth.uid == userId
            && !('activeTaskId' in request.resource.data)
            && request.resource.data.availabilityStatus == 'Available'
            && request.resource.data.availability == 'Available'
            && request.resource.data.get('completedTasks', 0) == resource.data.get('completedTasks', 0)
            && task(resource.data.activeTaskId).status in ['Accepted', 'Cancelled']
            && taskAfter(resource.data.activeTaskId).status == 'Cancelled'
            && taskAfter(resource.data.activeTaskId).workerId == userId
            && taskAfter(resource.data.activeTaskId).cancelledBy == request.auth.uid
            && taskAfter(resource.data.activeTaskId).cancelledByRole == 'worker'
          )
          ||
          (
            resource.data.activeTaskId is string
            && hasRole('client')
            && !('activeTaskId' in request.resource.data)
            && request.resource.data.availabilityStatus == 'Available'
            && request.resource.data.availability == 'Available'
            && request.resource.data.get('completedTasks', 0) == resource.data.get('completedTasks', 0)
            && task(resource.data.activeTaskId).status in ['Accepted', 'In Progress', 'Pending Approval', 'Cancelled']
            && taskAfter(resource.data.activeTaskId).status == 'Cancelled'
            && taskAfter(resource.data.activeTaskId).clientId == request.auth.uid
            && taskAfter(resource.data.activeTaskId).workerId == userId
          )
          ||
          (
            resource.data.activeTaskId is string
            && !('activeTaskId' in request.resource.data)
            && request.resource.data.availabilityStatus == 'Available'
            && request.resource.data.availability == 'Available'
            && request.resource.data.get('completedTasks', 0) == resource.data.get('completedTasks', 0)
            && task(resource.data.activeTaskId).status in ['Accepted', 'In Progress', 'Pending Approval']
            && taskAfter(resource.data.activeTaskId).status == 'Disputed'
            && taskAfter(resource.data.activeTaskId).workerId == userId
            && (
              taskAfter(resource.data.activeTaskId).clientId == request.auth.uid
              || (request.auth.uid == userId && task(resource.data.activeTaskId).workerId == request.auth.uid)
            )
          )
          ||
          (
            request.auth.uid == userId
            && resource.data.activeTaskId is string
            && !('activeTaskId' in request.resource.data)
            && request.resource.data.availabilityStatus == 'Available'
            && request.resource.data.availability == 'Available'
            && request.resource.data.get('completedTasks', 0) == resource.data.get('completedTasks', 0)
            && task(resource.data.activeTaskId).status == 'Disputed'
            && task(resource.data.activeTaskId).workerId == userId
          )
        );
    }

    function validWorkflowVisibleWorkerUpdate(userId) {
      return (hasRole('client') || (hasRole('worker') && request.auth.uid == userId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availabilityStatus',
          'availability',
          'completedTasks',
          'updatedAt'
        ])
        && (
          (
            'activeTaskId' in getAfter(/databases/$(database)/documents/users/$(userId)).data
            && hasRole('client')
            && request.resource.data.availabilityStatus == 'Busy'
            && request.resource.data.availability == 'Busy'
            && request.resource.data.get('completedTasks', 0) == resource.data.get('completedTasks', 0)
            && taskAfter(getAfter(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).status == 'Accepted'
            && taskAfter(getAfter(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).clientId == request.auth.uid
            && taskAfter(getAfter(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).workerId == userId
          )
          ||
          (
            'activeTaskId' in get(/databases/$(database)/documents/users/$(userId)).data
            && hasRole('client')
            && !('activeTaskId' in getAfter(/databases/$(database)/documents/users/$(userId)).data)
            && request.resource.data.availabilityStatus == 'Available'
            && request.resource.data.availability == 'Available'
            && request.resource.data.completedTasks
              == getAfter(/databases/$(database)/documents/users/$(userId)).data.completedTasks
            && taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).status == 'Finished'
            && taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).clientId == request.auth.uid
            && taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).workerId == userId
          )
          ||
          (
            'activeTaskId' in get(/databases/$(database)/documents/users/$(userId)).data
            && hasRole('worker')
            && request.auth.uid == userId
            && request.resource.data.availabilityStatus == 'Available'
            && request.resource.data.availability == 'Available'
            && request.resource.data.get('completedTasks', 0) == resource.data.get('completedTasks', 0)
            && task(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).status in ['Accepted', 'Cancelled']
            && taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).status == 'Cancelled'
            && taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).workerId == userId
            && taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).cancelledBy == request.auth.uid
            && taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).cancelledByRole == 'worker'
          )
          ||
          (
            'activeTaskId' in get(/databases/$(database)/documents/users/$(userId)).data
            && hasRole('client')
            && request.resource.data.availabilityStatus == 'Available'
            && request.resource.data.availability == 'Available'
            && request.resource.data.get('completedTasks', 0) == resource.data.get('completedTasks', 0)
            && task(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).status
              in ['Accepted', 'In Progress', 'Pending Approval', 'Cancelled']
            && taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).status == 'Cancelled'
            && taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).clientId == request.auth.uid
            && taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).workerId == userId
          )
          ||
          (
            'activeTaskId' in get(/databases/$(database)/documents/users/$(userId)).data
            && !('activeTaskId' in getAfter(/databases/$(database)/documents/users/$(userId)).data)
            && request.resource.data.availabilityStatus == 'Available'
            && request.resource.data.availability == 'Available'
            && request.resource.data.get('completedTasks', 0) == resource.data.get('completedTasks', 0)
            && task(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).status
              in ['Accepted', 'In Progress', 'Pending Approval']
            && taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).status == 'Disputed'
            && taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).workerId == userId
            && (
              taskAfter(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).clientId
                == request.auth.uid
              || (request.auth.uid == userId
                && task(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).workerId
                  == request.auth.uid)
            )
          )
          ||
          (
            request.auth.uid == userId
            && 'activeTaskId' in get(/databases/$(database)/documents/users/$(userId)).data
            && !('activeTaskId' in getAfter(/databases/$(database)/documents/users/$(userId)).data)
            && request.resource.data.availabilityStatus == 'Available'
            && request.resource.data.availability == 'Available'
            && request.resource.data.get('completedTasks', 0) == resource.data.get('completedTasks', 0)
            && task(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).status == 'Disputed'
            && task(get(/databases/$(database)/documents/users/$(userId)).data.activeTaskId).workerId == userId
          )
        );
    }

    function validOwnWorkerProfileUpdate(userId) {
      return hasEnabledAccount()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'skills',
          'capabilities',
          'availabilityStatus',
          'availability',
          'profilePhotoUrl',
          'experienceDescription',
          'yearsOfExperience',
          'validIdType',
          'validIdUrl',
          'medicalCertificateUrl',
          'policeClearanceUrl',
          'verificationStatus',
          'currentLatitude',
          'currentLongitude',
          'locationUpdatedAt',
          'locationAccuracyMeters',
          'locationSource',
          'preferredRadiusKm',
          'updatedAt'
        ])
        && validPreferredDiscoveryRadius(request.resource.data)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'currentLatitude', 'currentLongitude', 'locationUpdatedAt', 'locationAccuracyMeters', 'locationSource'
          ])
          || validPrivateLocation(request.resource.data)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'validIdType', 'validIdUrl', 'medicalCertificateUrl', 'policeClearanceUrl', 'verificationStatus'
          ])
          || (
            !identityLocked(get(/databases/$(database)/documents/users/$(userId)).data)
            && request.resource.data.verificationStatus == 'Pending Verification'
            && validVerificationDocumentPath(userId, request.resource.data.validIdUrl, 'valid-id')
            && validVerificationDocumentPath(userId, request.resource.data.medicalCertificateUrl, 'medical-certificate')
            && (!('policeClearanceUrl' in request.resource.data)
              || validVerificationDocumentPath(userId, request.resource.data.policeClearanceUrl, 'police-clearance'))
            && verificationAfter(userId).status == 'Pending Verification'
            && verificationAfter(userId).validIdType == request.resource.data.validIdType
            && verificationAfter(userId).validIdPath == request.resource.data.validIdUrl
            && verificationAfter(userId).medicalCertificatePath == request.resource.data.medicalCertificateUrl
            && (!('policeClearanceUrl' in request.resource.data)
              || verificationAfter(userId).policeClearancePath == request.resource.data.policeClearanceUrl)
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'availabilityStatus',
            'availability'
          ])
          || (
            get(/databases/$(database)/documents/users/$(userId)).data.role == 'client'
            && getAfter(/databases/$(database)/documents/users/$(userId)).data.role == 'worker'
            && request.resource.data.availabilityStatus == 'Available'
            && request.resource.data.availability == 'Available'
          )
        );
    }

    function validPublicProfileFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'role',
        'fullName',
        'rating',
        'ratingCount',
        'ratingTotal',
        'skills',
        'capabilities',
        'availabilityStatus',
        'availability',
        'businessName',
        'profilePhotoUrl',
        'experienceDescription',
        'yearsOfExperience',
        'verificationStatus',
        'completedTasks',
        'createdAt',
        'updatedAt'
      ]);
    }

    function validApplicationUpdate(taskId) {
      return hasRole('worker')
        && resource.data.clientId != request.auth.uid
        && isOpenTask(resource.data)
        && hasNoAssignedWorker(resource.data)
        && hasNoAssignedWorker(request.resource.data)
        && request.resource.data.applicantIds is list
        && !(request.auth.uid in applicationApplicantIds(resource.data))
        && request.auth.uid in request.resource.data.applicantIds
        && request.resource.data.lastApplicationWorkerId == request.auth.uid
        && request.resource.data.lastApplicationMatchId
          == taskId + '_' + request.auth.uid
        && request.resource.data.lastApplicationAction == 'Applied'
        && request.resource.data.applicantIds.hasAll(applicationApplicantIds(resource.data))
        && request.resource.data.applicantIds.size() == applicationApplicantIds(resource.data).size() + 1
        && request.resource.data.status == 'Applied'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'applicantIds',
          'status',
          'lastApplicationWorkerId',
          'lastApplicationMatchId',
          'lastApplicationAction',
          'updatedAt'
        ]);
    }

    function validApplicationRemoval(taskId) {
      return isOpenTask(resource.data)
        && !('workerId' in resource.data)
        && !('workerId' in request.resource.data)
        && resource.data.applicantIds is list
        && request.resource.data.applicantIds is list
        && resource.data.applicantIds.hasAll(request.resource.data.applicantIds)
        && request.resource.data.applicantIds.size() == resource.data.applicantIds.size() - 1
        && request.resource.data.status
          == (request.resource.data.applicantIds.size() == 0 ? 'Finding Workers' : 'Applied')
        && resource.data.applicantIds.hasAny([request.resource.data.lastApplicationWorkerId])
        && !request.resource.data.applicantIds.hasAny([request.resource.data.lastApplicationWorkerId])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'applicantIds',
          'status',
          'lastApplicationWorkerId',
          'lastApplicationMatchId',
          'lastApplicationAction',
          'updatedAt'
        ])
        && (
          (hasRole('worker')
            && request.resource.data.lastApplicationWorkerId == request.auth.uid
            && request.resource.data.lastApplicationMatchId
              == taskId + '_' + request.auth.uid
            && request.resource.data.lastApplicationAction == 'Withdrawn'
            && matchAfter(request.resource.data.lastApplicationMatchId).acceptanceStatus == 'Withdrawn')
          || (hasRole('client')
            && resource.data.clientId == request.auth.uid
            && request.resource.data.lastApplicationMatchId
              == taskId + '_' + request.resource.data.lastApplicationWorkerId
            && request.resource.data.lastApplicationAction == 'Rejected'
            && matchAfter(request.resource.data.lastApplicationMatchId).acceptanceStatus == 'Rejected')
        );
    }

    function validAssignedWorkerUpdate(taskId) {
      return hasRole('worker')
        && resource.data.workerId == request.auth.uid
        && request.resource.data.workerId == request.auth.uid
        && (!('changeRequest' in resource.data) || resource.data.changeRequest.status != 'Pending')
        && (
          (resource.data.status == 'Accepted'
            && request.resource.data.status == 'In Progress'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt', 'updatedAt']))
          ||
          (resource.data.status == 'In Progress'
            && request.resource.data.status == 'Pending Approval'
            && (resource.data.paymentMethod != 'GCash link'
              || (getAfter(/databases/$(database)/documents/payments/$(taskId)).data.paymentMethod == 'GCash link'
                && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.paymentStatus == 'Pending'
                && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.workerId == request.auth.uid
                && validGcashRecipientMobile(getAfter(/databases/$(database)/documents/payments/$(taskId)).data.gcashRecipientMobile)
                && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.gcashDetailsConfirmedAt is string
                && (!('gcashQrPath' in getAfter(/databases/$(database)/documents/payments/$(taskId)).data)
                  || validGcashQrPath(taskId, getAfter(/databases/$(database)/documents/payments/$(taskId)).data.gcashQrPath))))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'workerFinishedAt', 'updatedAt']))
          ||
          (resource.data.status in ['Accepted', 'In Progress', 'Pending Approval']
            && request.resource.data.status == 'Disputed'
            && !('activeTaskId' in getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.availabilityStatus
              == 'Available'
            && getAfter(/databases/$(database)/documents/workerProfiles/$(request.auth.uid)).data.availabilityStatus
              == 'Available'
            && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.availabilityStatus
              == 'Available'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disputedAt', 'updatedAt']))
          ||
          (resource.data.status == 'Finished'
            && request.resource.data.status == 'Disputed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disputedAt', 'updatedAt']))
        );
    }

    function validAssignedWorkerPaymentConfirmation(taskId) {
      return hasRole('worker')
        && resource.data.workerId == request.auth.uid
        && request.resource.data.workerId == request.auth.uid
        && resource.data.status == 'Pending Approval'
        && request.resource.data.status == 'Pending Approval'
        && resource.data.paymentMethod == 'COD'
        && resource.data.paymentStatus == 'Submitted'
        && request.resource.data.paymentStatus == 'Verified'
        && request.resource.data.workerConfirmedAt is string
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.paymentMethod == 'COD'
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.paymentStatus == 'Verified'
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.workerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.workerConfirmedAt
          == request.resource.data.workerConfirmedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentStatus',
          'workerConfirmedAt',
          'updatedAt'
        ]);
    }

    function validAssignedWorkerGcashPaymentConfirmation(taskId) {
      return hasRole('worker')
        && resource.data.workerId == request.auth.uid
        && request.resource.data.workerId == request.auth.uid
        && resource.data.status == 'Pending Approval'
        && request.resource.data.status == 'Pending Approval'
        && resource.data.paymentMethod == 'GCash link'
        && resource.data.paymentStatus == 'Awaiting Worker Confirmation'
        && request.resource.data.paymentStatus == 'Verified'
        && request.resource.data.workerConfirmedAt is string
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.paymentMethod == 'GCash link'
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.paymentStatus == 'Verified'
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.workerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.workerConfirmedAt
          == request.resource.data.workerConfirmedAt
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.gcashPaymentReceivedAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentStatus', 'workerConfirmedAt', 'updatedAt'
        ]);
    }

    function validAssignedWorkerPaymentProof(taskId) {
      return hasRole('worker')
        && resource.data.workerId == request.auth.uid
        && request.resource.data.workerId == request.auth.uid
        && resource.data.status in ['Accepted', 'In Progress', 'Pending Approval']
        && request.resource.data.status == resource.data.status
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.paymentStatus != 'Verified'
        && validWorkerPaymentProofPath(taskId, request.resource.data.workerProofOfPaymentUrl)
        && request.resource.data.workerProofSubmittedAt is string
        && (!('workerProofOfPaymentText' in request.resource.data)
          || (request.resource.data.workerProofOfPaymentText is string
            && request.resource.data.workerProofOfPaymentText.size() > 0))
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.workerProofOfPaymentUrl
          == request.resource.data.workerProofOfPaymentUrl
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.get('workerProofOfPaymentText', null)
          == request.resource.data.get('workerProofOfPaymentText', null)
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.workerProofSubmittedAt
          == request.resource.data.workerProofSubmittedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'workerProofOfPaymentUrl',
          'workerProofOfPaymentText',
          'workerProofSubmittedAt',
          'updatedAt'
        ]);
    }

    function validWorkerPaymentEvidenceUpdate(taskId) {
      return hasRole('worker')
        && task(taskId).workerId == request.auth.uid
        && resource.data.workerId == request.auth.uid
        && resource.data.paymentStatus != 'Verified'
        && taskAfter(taskId).status in ['Accepted', 'In Progress', 'Pending Approval']
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && validWorkerPaymentProofPath(taskId, request.resource.data.workerProofOfPaymentUrl)
        && request.resource.data.workerProofSubmittedAt is string
        && (!('workerProofOfPaymentText' in request.resource.data)
          || (request.resource.data.workerProofOfPaymentText is string
            && request.resource.data.workerProofOfPaymentText.size() > 0))
        && taskAfter(taskId).workerProofOfPaymentUrl == request.resource.data.workerProofOfPaymentUrl
        && taskAfter(taskId).get('workerProofOfPaymentText', null)
          == request.resource.data.get('workerProofOfPaymentText', null)
        && taskAfter(taskId).workerProofSubmittedAt == request.resource.data.workerProofSubmittedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'workerProofOfPaymentUrl',
          'workerProofOfPaymentText',
          'workerProofSubmittedAt',
          'updatedAt'
        ]);
    }

    function validClientGcashPaymentSent(taskId) {
      return hasRole('client')
        && resource.data.clientId == request.auth.uid
        && request.resource.data.clientId == request.auth.uid
        && resource.data.status == 'Pending Approval'
        && request.resource.data.status == 'Pending Approval'
        && resource.data.paymentMethod == 'GCash link'
        && resource.data.paymentStatus == 'Pending'
        && request.resource.data.paymentStatus == 'Awaiting Worker Confirmation'
        && request.resource.data.clientConfirmedAt is string
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.paymentMethod == 'GCash link'
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.paymentStatus
          == 'Awaiting Worker Confirmation'
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.clientConfirmedAt
          == request.resource.data.clientConfirmedAt
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.gcashPaymentSentAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentStatus', 'clientConfirmedAt', 'updatedAt'
        ]);
    }

    function validGcashReceivingDetailsUpdate(taskId) {
      return hasRole('worker')
        && task(taskId).workerId == request.auth.uid
        && ((task(taskId).status == 'In Progress'
          && taskAfter(taskId).status == 'Pending Approval')
          || (task(taskId).status == 'Pending Approval'
            && taskAfter(taskId).status == 'Pending Approval'))
        && resource.data.workerId == request.auth.uid
        && resource.data.paymentMethod == 'GCash link'
        && resource.data.paymentStatus == 'Pending'
        && request.resource.data.paymentStatus == 'Pending'
        && validGcashRecipientMobile(request.resource.data.gcashRecipientMobile)
        && request.resource.data.gcashDetailsConfirmedAt is string
        && (!('gcashQrPath' in request.resource.data)
          || validGcashQrPath(taskId, request.resource.data.gcashQrPath))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'gcashRecipientMobile', 'gcashQrPath', 'gcashDetailsConfirmedAt', 'updatedAt'
        ]);
    }

    function validGcashClientPaymentSentUpdate(taskId) {
      return hasRole('client')
        && task(taskId).clientId == request.auth.uid
        && task(taskId).status == 'Pending Approval'
        && resource.data.clientId == request.auth.uid
        && resource.data.paymentMethod == 'GCash link'
        && resource.data.paymentStatus == 'Pending'
        && request.resource.data.paymentStatus == 'Awaiting Worker Confirmation'
        && taskAfter(taskId).paymentStatus == 'Awaiting Worker Confirmation'
        && validGcashRecipientMobile(resource.data.gcashRecipientMobile)
        && request.resource.data.clientConfirmedAt is string
        && request.resource.data.gcashPaymentSentAt is string
        && (!('proofOfPaymentUrl' in request.resource.data)
          || validClientPaymentProofPath(taskId, request.resource.data.proofOfPaymentUrl))
        && (!('proofOfPaymentText' in request.resource.data)
          || (request.resource.data.proofOfPaymentText is string
            && request.resource.data.proofOfPaymentText.size() <= 500))
        && (!('gcashTransactionReference' in request.resource.data)
          || (request.resource.data.gcashTransactionReference is string
            && request.resource.data.gcashTransactionReference.size() <= 500))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentStatus', 'proofOfPaymentText', 'proofOfPaymentUrl', 'clientConfirmedAt',
          'gcashPaymentSentAt', 'gcashTransactionReference', 'updatedAt'
        ]);
    }

    function validGcashWorkerPaymentReceivedUpdate(taskId) {
      return hasRole('worker')
        && task(taskId).workerId == request.auth.uid
        && task(taskId).status == 'Pending Approval'
        && resource.data.workerId == request.auth.uid
        && resource.data.paymentMethod == 'GCash link'
        && resource.data.paymentStatus == 'Awaiting Worker Confirmation'
        && request.resource.data.paymentStatus == 'Verified'
        && taskAfter(taskId).paymentStatus == 'Verified'
        && request.resource.data.workerConfirmedAt is string
        && request.resource.data.gcashPaymentReceivedAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentStatus', 'workerConfirmedAt', 'gcashPaymentReceivedAt', 'updatedAt'
        ]);
    }

    function validGcashWorkerNotReceivedUpdate(taskId) {
      return hasRole('worker')
        && task(taskId).workerId == request.auth.uid
        && task(taskId).status == 'Pending Approval'
        && resource.data.workerId == request.auth.uid
        && resource.data.paymentMethod == 'GCash link'
        && resource.data.paymentStatus == 'Awaiting Worker Confirmation'
        && request.resource.data.paymentStatus == 'Awaiting Worker Confirmation'
        && request.resource.data.gcashPaymentNotReceivedAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'gcashPaymentNotReceivedAt', 'updatedAt'
        ]);
    }

    function validClientTaskUpdate(taskId) {
      return hasRole('client')
        && resource.data.clientId == request.auth.uid
        && request.resource.data.clientId == request.auth.uid
        && (
          (resource.data.status == 'Applied'
            && request.resource.data.status == 'Accepted'
            && request.resource.data.workerId in resource.data.applicantIds
            && request.resource.data.applicantIds == [request.resource.data.workerId]
            && request.resource.data.selectedMatchId
              == taskId + '_' + request.resource.data.workerId
            && matchAfter(request.resource.data.selectedMatchId).acceptanceStatus == 'Accepted'
            && request.resource.data.agreedAmount is string
            && request.resource.data.agreedAmount
              == (resource.data.get('pricingMode', 'fixed') == 'bidding'
                ? matchAfter(request.resource.data.selectedMatchId).proposedAmount
                : resource.data.wage)
            && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.workerId
              == request.resource.data.workerId
            && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.agreedAmount
              == request.resource.data.agreedAmount
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.workerId)).data.activeTaskId
              == taskId
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.workerId)).data.availabilityStatus
              == 'Busy'
            && getAfter(/databases/$(database)/documents/workerProfiles/$(request.resource.data.workerId)).data.availabilityStatus
              == 'Busy'
            && getAfter(/databases/$(database)/documents/publicProfiles/$(request.resource.data.workerId)).data.availabilityStatus
              == 'Busy'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'workerId', 'applicantIds', 'selectedMatchId', 'agreedAmount', 'acceptedAt', 'updatedAt'
            ]))
          ||
          (resource.data.status == 'Pending Approval'
            && request.resource.data.status == 'Finished'
            && resource.data.paymentStatus == 'Verified'
            && !('activeTaskId' in getAfter(/databases/$(database)/documents/users/$(resource.data.workerId)).data)
            && getAfter(/databases/$(database)/documents/users/$(resource.data.workerId)).data.completedTasks
              == get(/databases/$(database)/documents/users/$(resource.data.workerId)).data.get('completedTasks', 0) + 1
            && getAfter(/databases/$(database)/documents/workerProfiles/$(resource.data.workerId)).data.completedTasks
              == getAfter(/databases/$(database)/documents/users/$(resource.data.workerId)).data.completedTasks
            && getAfter(/databases/$(database)/documents/publicProfiles/$(resource.data.workerId)).data.completedTasks
              == getAfter(/databases/$(database)/documents/users/$(resource.data.workerId)).data.completedTasks
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'finishedAt', 'updatedAt']))
          ||
          (resource.data.status == 'Finished'
            && request.resource.data.status == 'Archived'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'archivedAt', 'updatedAt']))
          ||
          (resource.data.status in ['Accepted', 'In Progress', 'Pending Approval']
            && request.resource.data.status == 'Disputed'
            && !('activeTaskId' in getAfter(/databases/$(database)/documents/users/$(resource.data.workerId)).data)
            && getAfter(/databases/$(database)/documents/users/$(resource.data.workerId)).data.availabilityStatus
              == 'Available'
            && getAfter(/databases/$(database)/documents/workerProfiles/$(resource.data.workerId)).data.availabilityStatus
              == 'Available'
            && getAfter(/databases/$(database)/documents/publicProfiles/$(resource.data.workerId)).data.availabilityStatus
              == 'Available'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disputedAt', 'updatedAt']))
          ||
          (resource.data.status == 'Finished'
            && request.resource.data.status == 'Disputed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disputedAt', 'updatedAt']))
          ||
          (request.resource.data.status == resource.data.status
            && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.paymentStatus
              == request.resource.data.paymentStatus
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentStatus',
              'proofOfPaymentText',
              'proofOfPaymentUrl',
              'clientConfirmedAt',
              'updatedAt'
            ])
            && request.resource.data.paymentStatus == 'Submitted'
            && (!('proofOfPaymentUrl' in request.resource.data)
              || validClientPaymentProofPath(taskId, request.resource.data.proofOfPaymentUrl))
            && (!('proofOfPaymentText' in request.resource.data)
              || (request.resource.data.proofOfPaymentText is string
                && request.resource.data.proofOfPaymentText.size() > 0))
            && (
              getAfter(/databases/$(database)/documents/payments/$(taskId)).data.paymentMethod == 'COD'
                ? request.resource.data.clientConfirmedAt is string
                : true
            ))
          || validClientGcashPaymentSent(taskId)
          ||
          (resource.data.acceptanceStatus == 'Accepted'
            && request.resource.data.acceptanceStatus == 'Cancelled'
            && resource.data.workerId == request.auth.uid
            && taskAfter(resource.data.taskId).status == 'Cancelled'
            && taskAfter(resource.data.taskId).workerId == request.auth.uid
            && taskAfter(resource.data.taskId).cancelledBy == request.auth.uid
            && taskAfter(resource.data.taskId).cancelledByRole == 'worker')
        );
    }

    function validClientCancellation(taskId) {
      return hasRole('client')
        && resource.data.clientId == request.auth.uid
        && request.resource.data.clientId == request.auth.uid
        && (resource.data.status in ['Finding Workers', 'Applied']
          ? (request.resource.data.status == 'Cancelled'
            && validCancellationMetadata(taskId, 'client', 'open'))
          : (resource.data.status == 'Accepted'
            ? (request.resource.data.status == 'Cancelled'
              && validCancellationMetadata(taskId, 'client', 'pre-check-in'))
            : false));
    }

    // Editable terms deliberately exclude task ownership, status, assignment,
    // payment, and application fields. An unassigned task may change directly;
    // an accepted task can only store a review request for its assigned worker.
    function validTaskTerms(terms) {
      return terms.title is string && terms.title.size() >= 1 && terms.title.size() <= 160
        && terms.description is string && terms.description.size() >= 1 && terms.description.size() <= 5000
        && terms.category is string && terms.category.size() >= 1 && terms.category.size() <= 100
        && terms.location is string && terms.location.size() >= 1 && terms.location.size() <= 200
        && ('locationAddress' in terms) && terms.locationAddress is string && terms.locationAddress.size() >= 1 && terms.locationAddress.size() <= 500
        && terms.locationAddress.matches('.*Bacolod.*')
        && terms.latitude is number && terms.latitude >= -90 && terms.latitude <= 90
        && terms.latitude >= 10.54 && terms.latitude <= 10.86
        && terms.longitude is number && terms.longitude >= -180 && terms.longitude <= 180
        && terms.longitude >= 122.78 && terms.longitude <= 123.10
        && terms.geofenceRadius is number && terms.geofenceRadius >= 100 && terms.geofenceRadius <= 5000
        && terms.locationSource in ['device', 'manual', 'map']
        && terms.requiredCapabilities is list && terms.requiredCapabilities.size() >= 1 && terms.requiredCapabilities.size() <= 3
        && terms.requiredCapability is string
        && terms.wage is string
        && terms.pricingMode in ['fixed', 'bidding']
        && (terms.pricingMode == 'bidding' || terms.wage.matches('([1][5-9][0-9]|[2-9][0-9]{2}|[1-9][0-9]{3,})([.][0-9]{1,2})?'))
        && terms.estimatedDuration is string && terms.estimatedDuration.size() >= 1 && terms.estimatedDuration.size() <= 100
        && terms.durationValue is int && terms.durationValue >= 1 && terms.durationValue <= 365
        && terms.durationUnit in ['hour', 'day', 'week', 'month']
        && terms.scheduleMode in ['fixed', 'anytime']
        && (terms.scheduleMode == 'anytime'
          ? terms.scheduleDate is string
          : (terms.scheduleStart is string && terms.scheduleEnd is string))
        && terms.perks is list && terms.perks.size() <= 10;
    }

    function onlyTaskTermsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title', 'description', 'category', 'location', 'locationAddress', 'latitude', 'longitude',
        'geofenceRadius', 'locationCapturedAt', 'locationAccuracyMeters', 'locationSource',
        'requiredCapability', 'requiredCapabilities', 'wage', 'estimatedDuration', 'durationValue',
        'durationUnit', 'scheduleMode', 'scheduleDate', 'scheduleStart', 'scheduleEnd', 'pricingMode', 'perks', 'updatedAt'
      ]);
    }

    function validOpenTaskTermsUpdate() {
      return hasRole('client')
        && resource.data.clientId == request.auth.uid
        && request.resource.data.clientId == resource.data.clientId
        && isOpenTask(resource.data)
        && request.resource.data.status == resource.data.status
        && hasNoAssignedWorker(resource.data)
        && hasNoAssignedWorker(request.resource.data)
        && onlyTaskTermsChanged()
        && validTaskTerms(request.resource.data);
    }

    function validTaskChangeProposal() {
      return hasRole('client')
        && resource.data.clientId == request.auth.uid
        && resource.data.status == 'Accepted'
        && resource.data.workerId is string
        && request.resource.data.status == resource.data.status
        && request.resource.data.workerId == resource.data.workerId
        && (!('changeRequest' in resource.data) || resource.data.changeRequest.status != 'Pending')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['changeRequest', 'updatedAt'])
        && request.resource.data.changeRequest.keys().hasOnly([
          'version', 'status', 'requestedBy', 'requestedAt', 'previousTerms', 'proposedTerms', 'changedFields'
        ])
        && request.resource.data.changeRequest.version is int
        && request.resource.data.changeRequest.version == (('changeRequest' in resource.data) ? resource.data.changeRequest.version + 1 : 1)
        && request.resource.data.changeRequest.status == 'Pending'
        && request.resource.data.changeRequest.requestedBy == request.auth.uid
        && request.resource.data.changeRequest.requestedAt is string
        && request.resource.data.changeRequest.previousTerms is map
        && request.resource.data.changeRequest.proposedTerms is map
        && request.resource.data.changeRequest.changedFields is list
        && request.resource.data.changeRequest.changedFields.size() >= 1
        && validTaskTerms(request.resource.data.changeRequest.proposedTerms);
    }

    function proposedTermsApplied() {
      let terms = request.resource.data.changeRequest.proposedTerms;
      return request.resource.data.title == terms.title
        && request.resource.data.description == terms.description
        && request.resource.data.category == terms.category
        && request.resource.data.location == terms.location
        && request.resource.data.get('locationAddress', null) == terms.get('locationAddress', null)
        && request.resource.data.latitude == terms.latitude
        && request.resource.data.longitude == terms.longitude
        && request.resource.data.geofenceRadius == terms.geofenceRadius
        && request.resource.data.get('locationCapturedAt', null) == terms.get('locationCapturedAt', null)
        && request.resource.data.get('locationAccuracyMeters', null) == terms.get('locationAccuracyMeters', null)
        && request.resource.data.locationSource == terms.locationSource
        && request.resource.data.requiredCapability == terms.requiredCapability
        && request.resource.data.requiredCapabilities == terms.requiredCapabilities
        && request.resource.data.wage == terms.wage
        && request.resource.data.estimatedDuration == terms.estimatedDuration
        && request.resource.data.durationValue == terms.durationValue
        && request.resource.data.durationUnit == terms.durationUnit
        && request.resource.data.scheduleMode == terms.scheduleMode
        && request.resource.data.get('scheduleDate', null) == terms.get('scheduleDate', null)
        && request.resource.data.get('scheduleStart', null) == terms.get('scheduleStart', null)
        && request.resource.data.get('scheduleEnd', null) == terms.get('scheduleEnd', null)
        && request.resource.data.pricingMode == terms.pricingMode
        && request.resource.data.perks == terms.perks;
    }

    function validAssignedTaskChangeDecision() {
      return hasRole('worker')
        && resource.data.workerId == request.auth.uid
        && resource.data.status == 'Accepted'
        && request.resource.data.status == resource.data.status
        && resource.data.changeRequest.status == 'Pending'
        && request.resource.data.changeRequest.version == resource.data.changeRequest.version
        && request.resource.data.changeRequest.requestedBy == resource.data.changeRequest.requestedBy
        && request.resource.data.changeRequest.requestedAt == resource.data.changeRequest.requestedAt
        && request.resource.data.changeRequest.previousTerms == resource.data.changeRequest.previousTerms
        && request.resource.data.changeRequest.proposedTerms == resource.data.changeRequest.proposedTerms
        && request.resource.data.changeRequest.changedFields == resource.data.changeRequest.changedFields
        && request.resource.data.changeRequest.decidedAt is string
        && request.resource.data.changeRequest.status in ['Accepted', 'Rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'category', 'location', 'locationAddress', 'latitude', 'longitude',
          'geofenceRadius', 'locationCapturedAt', 'locationAccuracyMeters', 'locationSource',
          'requiredCapability', 'requiredCapabilities', 'wage', 'estimatedDuration', 'durationValue',
          'durationUnit', 'scheduleMode', 'scheduleDate', 'scheduleStart', 'scheduleEnd', 'pricingMode', 'perks',
          'changeRequest', 'updatedAt'
        ])
        && (request.resource.data.changeRequest.status == 'Rejected'
          ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['changeRequest', 'updatedAt'])
          : (validTaskTerms(request.resource.data) && proposedTermsApplied()));
    }

    function validCancellationMetadata(taskId, actorRole, stage) {
      return request.resource.data.status == 'Cancelled'
        && request.resource.data.cancelledAt is string
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelledByRole == actorRole
        && request.resource.data.cancellationStage == stage
        && request.resource.data.cancellationReason is string
        && request.resource.data.cancellationReason.size() >= 5
        && request.resource.data.cancellationReason.size() <= 500
        && request.resource.data.paymentStatusAtCancellation == resource.data.get('paymentStatus', 'Pending')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'cancelledBy', 'cancelledByRole', 'cancellationReason',
          'cancellationStage', 'paymentStatusAtCancellation', 'updatedAt'
        ]);
    }

    function validAssignedWorkerCancellation(taskId) {
      return hasRole('worker')
        && resource.data.status == 'Accepted'
        && resource.data.workerId == request.auth.uid
        && request.resource.data.workerId == resource.data.workerId
        && validCancellationMetadata(taskId, 'worker', 'pre-check-in');
    }

    match /users/{userId} {
      allow create: if validOwnUserDocument(userId)
        && validIdentityText(request.resource.data)
        && validInitialIdentityState(request.resource.data)
        && request.resource.data.accountStatus == 'active'
        && (
          (request.resource.data.role == 'worker'
            && request.resource.data.verificationStatus == 'Pending Verification')
          || (request.resource.data.role == 'client'
            && !('verificationStatus' in request.resource.data))
        );
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if validOwnPrivateLocationUpdate(userId) || (
          hasEnabledAccount()
          && validOwnUserDocument(userId)
          && request.resource.data.accountStatus == resource.data.accountStatus
          && request.resource.data.createdAt == resource.data.createdAt
          && validUserProfileUpdate()
        ) || validWorkflowPrivateWorkerUpdate(userId);
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if hasEnabledAccount();
      allow create: if signedIn()
        && request.auth.uid == userId
        && validPublicProfileFields()
        && request.resource.data.id == userId
        && request.resource.data.role in ['worker', 'client']
        && request.resource.data.role == getAfter(/databases/$(database)/documents/users/$(userId)).data.role
        && request.resource.data.fullName
          == getAfter(/databases/$(database)/documents/users/$(userId)).data.fullName
        && (
          !('accountStatus' in getAfter(/databases/$(database)/documents/users/$(userId)).data)
          || getAfter(/databases/$(database)/documents/users/$(userId)).data.accountStatus
            in ['active', 'pending_verification']
        )
        && request.resource.data.get('verificationStatus', null)
          == getAfter(/databases/$(database)/documents/users/$(userId)).data.get('verificationStatus', null)
        && request.resource.data.rating == getAfter(/databases/$(database)/documents/users/$(userId)).data.rating;
      allow update: if (
          hasEnabledAccount()
          && request.auth.uid == userId
          && validPublicProfileFields()
          && request.resource.data.id == userId
          && request.resource.data.role in ['worker', 'client']
          && request.resource.data.role == getAfter(/databases/$(database)/documents/users/$(userId)).data.role
          && request.resource.data.fullName
            == getAfter(/databases/$(database)/documents/users/$(userId)).data.fullName
          && request.resource.data.get('verificationStatus', null)
            == getAfter(/databases/$(database)/documents/users/$(userId)).data.get('verificationStatus', null)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'rating', 'ratingCount', 'ratingTotal', 'completedTasks', 'createdAt'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'availabilityStatus', 'availability'
            ]) || (
              get(/databases/$(database)/documents/users/$(userId)).data.role == 'client'
              && getAfter(/databases/$(database)/documents/users/$(userId)).data.role == 'worker'
              && request.resource.data.availabilityStatus == 'Available'
              && request.resource.data.availability == 'Available'
            ))
        ) || validWorkflowVisibleWorkerUpdate(userId);
      allow delete: if false;
    }

    match /workerProfiles/{userId} {
      allow read: if hasEnabledAccount() && request.auth.uid == userId;
      allow update: if validOwnWorkerProfileUpdate(userId)
        || validWorkflowVisibleWorkerUpdate(userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.role == 'worker'
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.accountStatus
          in ['active', 'pending_verification'];
      allow delete: if false;
    }

    match /clientProfiles/{userId} {
      allow read: if hasEnabledAccount() && request.auth.uid == userId;
      allow update: if hasEnabledAccount() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.role == 'client'
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.accountStatus
          in ['active', 'pending_verification'];
      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow read: if isAdmin();
      allow read: if hasEnabledAccount() && resource.data.status in ['Finding Workers', 'Applied'];
      allow read: if hasEnabledAccount() && resource.data.clientId == request.auth.uid;
      allow read: if hasEnabledAccount() && resource.data.workerId == request.auth.uid;
      allow read: if hasEnabledAccount() && request.auth.uid in resource.data.applicantIds;
      allow create: if hasRole('client')
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'Finding Workers'
        && validTaskTerms(request.resource.data)
        && request.resource.data.paymentMethod in ['COD', 'GCash link']
        && request.resource.data.paymentStatus == 'Pending'
        && (!('pricingMode' in request.resource.data)
          || request.resource.data.pricingMode in ['fixed', 'bidding'])
        && (!('durationValue' in request.resource.data)
          || (request.resource.data.durationValue is int
            && request.resource.data.durationValue >= 1
            && request.resource.data.durationValue <= 365))
        && (!('durationUnit' in request.resource.data)
          || request.resource.data.durationUnit in ['hour', 'day', 'week', 'month'])
        && (!('scheduleStart' in request.resource.data) || request.resource.data.scheduleStart is string)
        && (!('scheduleEnd' in request.resource.data) || request.resource.data.scheduleEnd is string)
        && (!('perks' in request.resource.data)
          || (request.resource.data.perks is list && request.resource.data.perks.size() <= 10))
        && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt is string)
        && request.resource.data.applicantIds is list
        && request.resource.data.applicantIds.size() == 0
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.latitude >= 10.54
        && request.resource.data.latitude <= 10.86
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.longitude >= 122.78
        && request.resource.data.longitude <= 123.10
        && request.resource.data.geofenceRadius is number
        && request.resource.data.geofenceRadius >= 100
        && request.resource.data.geofenceRadius <= 5000
        && request.resource.data.locationCapturedAt is string
        && request.resource.data.locationSource in ['device', 'manual', 'map']
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.id == taskId
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.clientId == request.auth.uid
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.paymentMethod
          == request.resource.data.paymentMethod
        && getAfter(/databases/$(database)/documents/payments/$(taskId)).data.paymentStatus == 'Pending'
        && (!('locationAccuracyMeters' in request.resource.data)
          || (request.resource.data.locationAccuracyMeters is number
            && request.resource.data.locationAccuracyMeters >= 0));
      allow update: if request.resource.data.status == 'Cancelled'
        ? (validClientCancellation(taskId) || validAssignedWorkerCancellation(taskId))
        : (request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'workerProofOfPaymentUrl', 'workerProofOfPaymentText', 'workerProofSubmittedAt'
          ])
          ? validAssignedWorkerPaymentProof(taskId)
          : (validClientTaskUpdate(taskId)
          || validApplicationUpdate(taskId)
          || validApplicationRemoval(taskId)
          || validAssignedWorkerUpdate(taskId)
          || validAssignedWorkerPaymentConfirmation(taskId)
          || validAssignedWorkerGcashPaymentConfirmation(taskId)
          || validAssignedWorkerPaymentProof(taskId)));
      allow delete: if false;

      match /history/{eventId} {
        allow read: if isAdmin() || (hasEnabledAccount() && isTaskParticipant(task(taskId)));
        allow create: if hasEnabledAccount()
          && eventId == 'cancellation'
          && request.resource.data.keys().hasOnly([
            'type', 'taskId', 'actorId', 'actorRole', 'reason', 'stage', 'paymentStatusAtEvent', 'createdAt'
          ])
          && request.resource.data.type == 'Task cancelled'
          && request.resource.data.taskId == taskId
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorRole in ['client', 'worker']
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 5
          && request.resource.data.reason.size() <= 500
          && request.resource.data.stage in ['open', 'pre-check-in']
          && taskAfter(taskId).status == 'Cancelled'
          && taskAfter(taskId).cancelledBy == request.auth.uid
          && taskAfter(taskId).cancelledByRole == request.resource.data.actorRole
          && taskAfter(taskId).cancellationReason == request.resource.data.reason
          && taskAfter(taskId).cancellationStage == request.resource.data.stage
          && taskAfter(taskId).paymentStatusAtCancellation == request.resource.data.paymentStatusAtEvent
          && request.resource.data.createdAt == taskAfter(taskId).cancelledAt;
        allow update, delete: if false;
      }

      match /liveLocation/{locationId} {
        allow read: if hasEnabledAccount()
          && locationId == 'current'
          && task(taskId).status in ['Accepted', 'In Progress']
          && (task(taskId).clientId == request.auth.uid || task(taskId).workerId == request.auth.uid);
        allow create, update: if hasRole('worker')
          && locationId == 'current'
          && task(taskId).workerId == request.auth.uid
          && task(taskId).status in ['Accepted', 'In Progress']
          && request.resource.data.keys().hasOnly([
            'workerId', 'latitude', 'longitude', 'accuracyMeters', 'capturedAt', 'updatedAt'
          ])
          && request.resource.data.workerId == request.auth.uid
          && request.resource.data.latitude is number
          && request.resource.data.latitude >= -90
          && request.resource.data.latitude <= 90
          && request.resource.data.longitude is number
          && request.resource.data.longitude >= -180
          && request.resource.data.longitude <= 180
          && request.resource.data.accuracyMeters is number
          && request.resource.data.accuracyMeters >= 0
          && request.resource.data.capturedAt is string
          && request.resource.data.updatedAt == request.resource.data.capturedAt;
        allow delete: if hasRole('worker')
          && locationId == 'current'
          && task(taskId).workerId == request.auth.uid
          && resource.data.workerId == request.auth.uid;
      }
    }

    match /taskMatches/{matchId} {
      allow read: if isAdmin() || (hasEnabledAccount()
        && (resource.data.workerId == request.auth.uid || resource.data.clientId == request.auth.uid));
      allow create: if hasEnabledAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'taskId', 'workerId', 'clientId', 'acceptanceStatus', 'proposedAmount', 'createdAt', 'updatedAt'
        ])
        && matchId == request.resource.data.taskId + '_' + request.resource.data.workerId
        && request.resource.data.taskId is string
        && request.resource.data.clientId == task(request.resource.data.taskId).clientId
        && hasRole('worker')
        && request.resource.data.workerId == request.auth.uid
        && task(request.resource.data.taskId).clientId != request.auth.uid
        && isOpenTask(task(request.resource.data.taskId))
        && hasNoAssignedWorker(task(request.resource.data.taskId))
        && (
          task(request.resource.data.taskId).get('pricingMode', 'fixed') == 'fixed'
          || (request.resource.data.proposedAmount is string
            && request.resource.data.proposedAmount.matches('[1-9][0-9]*([.][0-9]{1,2})?'))
        )
        && request.resource.data.acceptanceStatus == 'Applied';
      allow update: if hasEnabledAccount()
        && request.resource.data.workerId == resource.data.workerId
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.taskId == resource.data.taskId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'acceptanceStatus',
          'hiredAt',
          'rejectedAt',
          'withdrawnAt',
          'cancelledAt',
          'updatedAt'
        ])
        && (
          (resource.data.acceptanceStatus in ['Applied', 'Accepted']
            && request.resource.data.acceptanceStatus == 'Cancelled'
            && resource.data.workerId == request.auth.uid
            && taskAfter(resource.data.taskId).status == 'Cancelled'
            && taskAfter(resource.data.taskId).workerId == request.auth.uid
            && taskAfter(resource.data.taskId).cancelledBy == request.auth.uid
            && taskAfter(resource.data.taskId).cancelledByRole == 'worker')
          ||
          (resource.data.acceptanceStatus == 'Applied'
            && request.resource.data.acceptanceStatus == 'Withdrawn'
            && resource.data.workerId == request.auth.uid
            && !(request.auth.uid in taskAfter(resource.data.taskId).applicantIds))
          ||
          (resource.data.clientId == request.auth.uid
            && (
              (resource.data.acceptanceStatus == 'Applied'
                && request.resource.data.acceptanceStatus == 'Accepted'
                && taskAfter(resource.data.taskId).status == 'Accepted'
                && taskAfter(resource.data.taskId).workerId == resource.data.workerId)
              ||
              (resource.data.acceptanceStatus == 'Applied'
                && request.resource.data.acceptanceStatus == 'Rejected'
                && !(resource.data.workerId in taskAfter(resource.data.taskId).applicantIds))
              ||
              (resource.data.acceptanceStatus in ['Applied', 'Accepted']
                && request.resource.data.acceptanceStatus == 'Cancelled'
                && taskAfter(resource.data.taskId).status == 'Cancelled'
                && (
                  resource.data.clientId == request.auth.uid
                  || (resource.data.workerId == request.auth.uid
                    && taskAfter(resource.data.taskId).workerId == request.auth.uid
                    && taskAfter(resource.data.taskId).cancelledBy == request.auth.uid
                    && taskAfter(resource.data.taskId).cancelledByRole == 'worker')
                ))
            ))
        );
      allow delete: if false;
    }

    match /paymentProofFiles/{taskId}/uploads/{party} {
      allow read: if isAdmin() || isAssignedPaymentParticipant(task(taskId));
      allow create, update: if hasEnabledAccount()
        && request.resource.data.keys().hasOnly([
          'taskId',
          'party',
          'uploaderId',
          'fileName',
          'mimeType',
          'byteSize',
          'encodedSize',
          'chunkCount',
          'version',
          'status',
          'createdAt'
        ])
        && request.resource.data.taskId == taskId
        && request.resource.data.party == party
        && party in ['client', 'worker', 'worker-gcash-qr']
        && request.resource.data.uploaderId == request.auth.uid
        && isAssignedPaymentParticipant(task(taskId))
        && (task(taskId).status in ['Accepted', 'In Progress', 'Pending Approval']
          || (party == 'client'
            && task(taskId).paymentMethod == 'GCash link'
            && task(taskId).status == 'Finished'
            && task(taskId).paymentStatus == 'Pending'))
        && ((party == 'client' && task(taskId).paymentStatus == 'Pending')
          || (party == 'worker'
            && task(taskId).paymentStatus != 'Verified')
          || (party == 'worker-gcash-qr'
            && task(taskId).paymentMethod == 'GCash link'
            && task(taskId).status in ['In Progress', 'Pending Approval']
            && task(taskId).paymentStatus == 'Pending'))
        && ((party == 'client' && task(taskId).clientId == request.auth.uid)
          || ((party == 'worker' || party == 'worker-gcash-qr')
            && task(taskId).workerId == request.auth.uid))
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 100
        && request.resource.data.mimeType is string
        && (request.resource.data.mimeType.matches('image/.+')
          || request.resource.data.mimeType == 'application/pdf')
        && request.resource.data.byteSize is int
        && request.resource.data.byteSize > 0
        && request.resource.data.byteSize <= 5242880
        && request.resource.data.encodedSize is int
        && request.resource.data.encodedSize > 0
        && request.resource.data.encodedSize <= 6991000
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 16
        && request.resource.data.version is string
        && request.resource.data.version.size() > 0
        && request.resource.data.status == 'ready'
        && request.resource.data.createdAt is string;
      allow delete: if false;

      match /chunks/{chunkId} {
        allow read: if isAdmin()
          || isAssignedPaymentParticipant(task(taskId));
        allow create, update: if hasEnabledAccount()
          && request.resource.data.keys().hasOnly([
            'id', 'taskId', 'party', 'uploaderId', 'index', 'version', 'data', 'createdAt'
          ])
          && request.resource.data.id == chunkId
          && request.resource.data.taskId == taskId
          && request.resource.data.party == party
          && request.resource.data.uploaderId == request.auth.uid
          && paymentProofFileAfter(taskId, party).taskId == taskId
          && paymentProofFileAfter(taskId, party).party == party
          && paymentProofFileAfter(taskId, party).uploaderId == request.auth.uid
          && paymentProofFileAfter(taskId, party).status == 'ready'
          && request.resource.data.version == paymentProofFileAfter(taskId, party).version
          && request.resource.data.createdAt == paymentProofFileAfter(taskId, party).createdAt
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.index < paymentProofFileAfter(taskId, party).chunkCount
          && request.resource.data.data is string
          && request.resource.data.data.size() > 0
          && request.resource.data.data.size() <= 450000
          && isAssignedPaymentParticipant(task(taskId))
          && (task(taskId).status in ['Accepted', 'In Progress', 'Pending Approval']
            || (party == 'client'
              && task(taskId).paymentMethod == 'GCash link'
              && task(taskId).status == 'Finished'
              && task(taskId).paymentStatus == 'Pending'))
          && ((party == 'client' && task(taskId).paymentStatus == 'Pending')
            || (party == 'worker'
              && task(taskId).paymentStatus != 'Verified')
            || (party == 'worker-gcash-qr'
              && task(taskId).paymentMethod == 'GCash link'
              && task(taskId).status in ['In Progress', 'Pending Approval']
              && task(taskId).paymentStatus == 'Pending'));
        allow delete: if false;
      }
    }

    match /payments/{taskId} {
      allow read: if isAdmin() || (hasEnabledAccount() && isTaskParticipant(task(taskId)));
      allow create: if hasRole('client')
        && taskAfter(taskId).clientId == request.auth.uid
        && request.resource.data.id == taskId
        && request.resource.data.taskId == taskId
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.paymentMethod == taskAfter(taskId).paymentMethod
        && request.resource.data.paymentMethod in ['COD', 'GCash link']
        && request.resource.data.paymentStatus == 'Pending'
        && !('workerId' in request.resource.data);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'workerProofOfPaymentUrl', 'workerProofOfPaymentText', 'workerProofSubmittedAt'
        ])
        ? validWorkerPaymentEvidenceUpdate(taskId)
        : ((
          hasRole('client')
          && task(taskId).clientId == request.auth.uid
          && request.resource.data.taskId == taskId
          && request.resource.data.clientId == request.auth.uid
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerId', 'agreedAmount', 'updatedAt'])
              && taskAfter(taskId).status == 'Accepted'
              && request.resource.data.workerId == taskAfter(taskId).workerId
              && request.resource.data.agreedAmount == taskAfter(taskId).agreedAmount)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'paymentStatus',
                'proofOfPaymentText',
                'proofOfPaymentUrl',
                'clientConfirmedAt',
                'updatedAt'
              ])
              && request.resource.data.paymentStatus == 'Submitted'
              && taskAfter(taskId).paymentStatus == 'Submitted'
              && taskAfter(taskId).get('proofOfPaymentText', null)
                == request.resource.data.get('proofOfPaymentText', null)
              && taskAfter(taskId).get('proofOfPaymentUrl', null)
                == request.resource.data.get('proofOfPaymentUrl', null)
              && taskAfter(taskId).get('clientConfirmedAt', null)
                == request.resource.data.get('clientConfirmedAt', null))
            || validGcashClientPaymentSentUpdate(taskId)
          )
        ) || (
          hasRole('worker')
          && task(taskId).workerId == request.auth.uid
          && task(taskId).status == 'Pending Approval'
          && task(taskId).paymentMethod == 'COD'
          && resource.data.workerId == request.auth.uid
          && resource.data.paymentMethod == 'COD'
          && resource.data.paymentStatus == 'Submitted'
          && request.resource.data.paymentStatus == 'Verified'
          && request.resource.data.workerConfirmedAt is string
          && taskAfter(taskId).paymentStatus == 'Verified'
          && taskAfter(taskId).workerConfirmedAt == request.resource.data.workerConfirmedAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'paymentStatus',
            'workerConfirmedAt',
            'updatedAt'
          ])
        ) || validGcashReceivingDetailsUpdate(taskId)
          || validGcashWorkerPaymentReceivedUpdate(taskId)
          || validGcashWorkerNotReceivedUpdate(taskId));
      allow delete: if false;
    }

    match /verificationFiles/{userId}/uploads/{kind} {
      allow read: if isAdmin() || (hasEnabledAccount() && request.auth.uid == userId);
      allow create, update: if hasEnabledAccount()
        && request.auth.uid == userId
        && kind in ['valid-id', 'medical-certificate', 'police-clearance']
        && request.resource.data.keys().hasOnly([
          'userId', 'kind', 'uploaderId', 'fileName', 'mimeType', 'byteSize',
          'encodedSize', 'chunkCount', 'version', 'status', 'createdAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.kind == kind
        && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 100
        && request.resource.data.mimeType is string
        && (request.resource.data.mimeType.matches('image/.+')
          || request.resource.data.mimeType == 'application/pdf')
        && request.resource.data.byteSize is int
        && request.resource.data.byteSize > 0
        && request.resource.data.byteSize <= 5242880
        && request.resource.data.encodedSize is int
        && request.resource.data.encodedSize > 0
        && request.resource.data.encodedSize <= 6991000
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 16
        && request.resource.data.version is string
        && request.resource.data.version.size() > 0
        && request.resource.data.status in ['uploading', 'ready']
        && request.resource.data.createdAt is string;
      allow delete: if false;

      match /chunks/{chunkId} {
        allow read: if isAdmin() || (hasEnabledAccount() && request.auth.uid == userId);
        allow create, update: if hasEnabledAccount()
          && request.auth.uid == userId
          && kind in ['valid-id', 'medical-certificate', 'police-clearance']
          && request.resource.data.keys().hasOnly([
            'id', 'userId', 'kind', 'uploaderId', 'index', 'version', 'data', 'createdAt'
          ])
          && request.resource.data.id == chunkId
          && request.resource.data.userId == userId
          && request.resource.data.kind == kind
          && request.resource.data.uploaderId == request.auth.uid
          && verificationFileAfter(userId, kind).userId == userId
          && verificationFileAfter(userId, kind).kind == kind
          && verificationFileAfter(userId, kind).uploaderId == request.auth.uid
          && verificationFileAfter(userId, kind).status in ['uploading', 'ready']
          && request.resource.data.version == verificationFileAfter(userId, kind).version
          && request.resource.data.createdAt == verificationFileAfter(userId, kind).createdAt
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.index < verificationFileAfter(userId, kind).chunkCount
          && request.resource.data.data is string
          && request.resource.data.data.size() > 0
          && request.resource.data.data.size() <= 450000;
        allow delete: if false;
      }
    }

    match /verificationRequests/{userId} {
      allow read: if isAdmin() || (hasEnabledAccount() && request.auth.uid == userId);
      allow create, update: if (hasRole('worker') || hasRole('client'))
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'userId', 'validIdType', 'validIdPath', 'medicalCertificatePath', 'policeClearancePath',
          'status', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.validIdType is string
        && request.resource.data.validIdType.size() > 0
        && validVerificationDocumentPath(userId, request.resource.data.validIdPath, 'valid-id')
        && validVerificationDocumentPath(userId, request.resource.data.medicalCertificatePath, 'medical-certificate')
        && (!('policeClearancePath' in request.resource.data)
          || validVerificationDocumentPath(userId, request.resource.data.policeClearancePath, 'police-clearance'))
        && request.resource.data.status == 'Pending Verification';
      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /violationReports/{reportId} {
      allow read: if isSuperadmin();
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if hasEnabledAccount()
        && resource.data.participantIds is list
        && request.auth.uid in resource.data.participantIds;
      allow create: if hasEnabledAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'taskId', 'workerId', 'participantIds', 'lastMessage', 'lastMessageAt',
          'lastSenderId', 'updatedAt'
        ])
        && request.resource.data.taskId is string
        && request.resource.data.workerId is string
        && chatId == request.resource.data.taskId + '_' + request.resource.data.workerId
        && request.resource.data.id == chatId
        && isConversationWorker(task(request.resource.data.taskId), request.resource.data.workerId)
        && validConversationParticipants(
          task(request.resource.data.taskId),
          request.resource.data.workerId,
          request.resource.data.participantIds
        )
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageAt is string;
      allow update: if hasEnabledAccount()
        && request.auth.uid in resource.data.participantIds
        && isConversationWorker(task(resource.data.taskId), resource.data.workerId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.taskId == resource.data.taskId
        && request.resource.data.workerId == resource.data.workerId
        && validConversationParticipants(
          task(resource.data.taskId),
          resource.data.workerId,
          request.resource.data.participantIds
        )
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participantIds', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if hasEnabledAccount()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if hasEnabledAccount()
        && request.resource.data.keys().hasOnly([
          'conversationId', 'taskId', 'senderId', 'receiverId', 'participantIds', 'message', 'timestamp'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.conversationId is string
        && request.resource.data.taskId is string
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.receiverId in request.resource.data.participantIds
        && request.resource.data.participantIds.hasAll([
          request.resource.data.senderId, request.resource.data.receiverId
        ])
        && request.resource.data.participantIds.hasOnly(
          getAfter(/databases/$(database)/documents/chats/$(request.resource.data.conversationId)).data.participantIds
        )
        && request.resource.data.taskId
          == getAfter(/databases/$(database)/documents/chats/$(request.resource.data.conversationId)).data.taskId
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.timestamp is string;
      allow update: if hasEnabledAccount()
        && resource.data.receiverId == request.auth.uid
        && request.resource.data.readAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow delete: if false;
    }

    match /pushTokens/{tokenId} {
      allow read: if hasEnabledAccount() && resource.data.userId == request.auth.uid;
      allow create: if hasEnabledAccount()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.enabled is bool;
      allow update: if hasEnabledAccount()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.token == resource.data.token
        && request.resource.data.platform == resource.data.platform
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled', 'updatedAt']);
      allow delete: if hasEnabledAccount() && resource.data.userId == request.auth.uid;
    }

    match /notificationPreferences/{userId} {
      allow read: if hasEnabledAccount() && request.auth.uid == userId;
      allow create, update: if hasEnabledAccount()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasOnly([
          'userId', 'pushEnabled', 'messagesEnabled', 'taskUpdatesEnabled', 'matchingEnabled', 'updatedAt'
        ])
        && request.resource.data.pushEnabled is bool
        && request.resource.data.messagesEnabled is bool
        && request.resource.data.taskUpdatesEnabled is bool
        && request.resource.data.matchingEnabled is bool;
      allow delete: if false;
    }

    match /ratings/{ratingId} {
      allow read: if hasEnabledAccount();
      allow create: if hasEnabledAccount()
        && ratingId == request.resource.data.taskId + '_' + request.auth.uid
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5
        && task(request.resource.data.taskId).status in ['Finished', 'Archived']
        && (
          (task(request.resource.data.taskId).clientId == request.auth.uid
            && task(request.resource.data.taskId).workerId == request.resource.data.targetUserId)
          ||
          (task(request.resource.data.taskId).workerId == request.auth.uid
            && task(request.resource.data.taskId).clientId == request.resource.data.targetUserId)
        );
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if hasEnabledAccount() && resource.data.userId == request.auth.uid;
      allow create: if hasEnabledAccount()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.taskId is string
        && (
          isNotificationParticipant(task(request.resource.data.taskId), request.auth.uid)
          || isNotificationParticipant(taskAfter(request.resource.data.taskId), request.auth.uid)
        )
        && (
          isNotificationParticipant(task(request.resource.data.taskId), request.resource.data.userId)
          || isNotificationParticipant(taskAfter(request.resource.data.taskId), request.resource.data.userId)
        );
      allow update: if hasEnabledAccount()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readStatus', 'openedAt', 'applicationConvertedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['readStatus'])
          || request.resource.data.readStatus == true
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['openedAt'])
          || request.resource.data.openedAt is string
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['applicationConvertedAt'])
          || request.resource.data.applicationConvertedAt is string
        );
      allow delete: if false;
    }

    match /analyticsSnapshots/{snapshotId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
