# Public Firebase client configuration. Copy this file to .env and fill in
# values from the Firebase project settings. Never place service-account keys here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Public beta support mailbox shown in the app. Do not use a private personal address.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Android production maps key. Restrict it to the Android package/signing certificate.
GOOGLE_MAPS_API_KEY=
