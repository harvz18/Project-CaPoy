# Copy these names into the EAS "preview" environment and Render.
# Never commit populated values or tester credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Public project-owned beta mailbox displayed in the app.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Build-time Android Maps SDK key. Store it as an EAS sensitive variable (not
# secret, because dynamic app config must resolve it), and restrict it to
# com.tasklink.app plus the preview signing certificate before distribution.
GOOGLE_MAPS_API_KEY=
