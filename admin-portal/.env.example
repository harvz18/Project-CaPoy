# Firebase web configuration only. These values are public client identifiers,
# not Admin SDK credentials. Set them in Render as build environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL of the separately deployed, trusted admin API. This is not a Firebase
# Function URL; use the Render Web Service URL, without a trailing slash.
VITE_ADMIN_API_BASE_URL=
