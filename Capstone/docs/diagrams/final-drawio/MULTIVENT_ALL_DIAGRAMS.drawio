        <mxCell id="input_client" value="&lt;b&gt;CLIENT · EVENT &amp; BUDGET&lt;/b&gt;&lt;br&gt;&lt;br&gt;Event name  [________________]&lt;br&gt;Event type  [ Select        v ]&lt;br&gt;Date        [ yyyy-mm-dd    ]&lt;br&gt;Time        [ --:--         ]&lt;br&gt;Guest count [______________]&lt;br&gt;Venue       [______________]&lt;br&gt;&lt;br&gt;&lt;b&gt;Category allocations&lt;/b&gt;&lt;br&gt;Venue       PHP [__________]&lt;br&gt;Catering    PHP [__________]&lt;br&gt;Coordinator PHP [__________]&lt;br&gt;&lt;br&gt;&lt;i&gt;Inline rule:&lt;/i&gt; Allocations cannot exceed&lt;br&gt;the total event budget.&lt;br&gt;&lt;br&gt;[ Back ]          [ Save and continue ]" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#202020;fillColor=#FFFFFF;strokeColor=#202020;strokeWidth=2;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60.00" y="135.00" width="510.00" height="825.00" as="geometry" />
        </mxCell>
        <mxCell id="input_provider" value="&lt;b&gt;PROVIDER · SERVICE LISTING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Category     [ Select        v ]&lt;br&gt;Service name [________________]&lt;br&gt;Description  [________________]&lt;br&gt;             [________________]&lt;br&gt;Base price   PHP [___________]&lt;br&gt;Pricing unit [ Event / Person ]&lt;br&gt;Cover image  [ Choose photo  ]&lt;br&gt;&lt;br&gt;&lt;b&gt;Category-specific options&lt;/b&gt;&lt;br&gt;Option name  [________________]&lt;br&gt;Guest range  [____] to [____]&lt;br&gt;Price/head   PHP [___________]&lt;br&gt;Menu items   [ + Add item    ]&lt;br&gt;&lt;br&gt;&lt;i&gt;Validation appears next to the field.&lt;/i&gt;&lt;br&gt;&lt;br&gt;[ Save draft ]    [ Review listing ]" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#202020;fillColor=#FFFFFF;strokeColor=#202020;strokeWidth=2;spacing=12;" vertex="1" parent="1">
