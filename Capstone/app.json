{
  "expo": {
    "name": "MULTIVENT",
    "slug": "multivent-mobile",
    "scheme": "multivent",
    "version": "1.0.0",
    "icon": "./assets/multivent-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.intelink.multivent",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.intelink.multivent",
      "adaptiveIcon": {
        "foregroundImage": "./assets/multivent-mark-transparent.png",
        "backgroundColor": "#FFF8F1"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/multivent-icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MULTIVENT to select service photos from your device.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F1",
          "image": "./assets/multivent-mark-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "0e44b632-3118-4aeb-bb74-017a9d0866b1"
      }
    },
    "owner": "harvz1827"
  }
}
