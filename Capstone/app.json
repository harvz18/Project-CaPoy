{
  "expo": {
    "name": "MULTIVENT",
    "slug": "multivent-mobile",
    "scheme": "multivent",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.intelink.multivent",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.intelink.multivent"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MULTIVENT to select service photos from your device.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "1eec28bc-ce22-43f4-b877-ad1763539a85"
      }
    },
    "owner": "shaolin18"
  }
}
