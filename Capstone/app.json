{
  "expo": {
    "name": "MULTIVENT",
    "slug": "multivent-mobile",
    "scheme": "multivent",
    "version": "1.0.0",
    "icon": "./assets/multivent-icon-padded.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.intelink.multivent",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.intelink.multivent",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/multivent-icon-padded.png",
        "backgroundColor": "#630019"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/multivent-icon-padded.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MULTIVENT to select service photos from your device.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#6B1E2E",
          "defaultChannel": "multivent-updates"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#630019",
          "image": "./assets/multivent-icon-padded.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-font",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ]
    ],
    "owner": "kriegovich",
    "extra": {
      "eas": {
        "projectId": "e61f0ff3-0365-4564-90ec-4a9627486c57"
      }
    }
  }
}
