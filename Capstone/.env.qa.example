# Copy this to .env.qa.local. Never put a production project reference, a real
# payment credential, or a Supabase service-role key in this file.
MV_QA_ENV=staging
QA_SUPABASE_URL=https://your-staging-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
QA_ALLOWED_SUPABASE_PROJECT_REF=your-staging-project-ref
QA_LIVE_SUPABASE_PROJECT_REF=your-live-project-ref
QA_PAYMENT_MODE=prototype
QA_RUN_CONFIRMATION=I_UNDERSTAND_THIS_IS_STAGING
